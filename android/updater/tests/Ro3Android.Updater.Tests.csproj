<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android updater's engine (compiled for the phone by ..\Ro3Android.Updater.csproj) run on the PC against
       repositories made by src\Ro3Emu.Patcher's Publisher: the two sides of the format checked together. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Model.cs;..\Installer.cs;..\Repository.cs;..\MiniJson.cs;..\RawHttp.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Ro3Emu.Patcher\Ro3Emu.Patcher.csproj" />
  </ItemGroup>

</Project>
